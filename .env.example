# Copy to .env for local development. Never commit real credentials.
# Read from the working directory only; deploy images must not ship a .env.

# Local compose PostgreSQL. POSTGRES_USER is a superuser, which bypasses
# row-level security. The API refuses such a role unless
# DATABASE_ALLOW_PRIVILEGED_ROLE=true (below); never set that outside local
# development.
POSTGRES_DB=scanpay
POSTGRES_USER=scanpay
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# postgres://user:password@host[:port]/database, every part written out.
DATABASE_URL=postgres://scanpay:change-me@127.0.0.1:5432/scanpay
DATABASE_MAX_CONNECTIONS=5
DATABASE_ALLOW_PRIVILEGED_ROLE=true
API_BIND_ADDR=127.0.0.1:3000

# Logging: RUST_LOG is a tracing filter; LOG_FORMAT is text or json
# (production must set json). Invalid values stop startup.
RUST_LOG=info,sqlx=warn,hyper=warn,tower=warn,tower_http=info
LOG_FORMAT=text
# Span export over OTLP/HTTP; off when unset. Example: http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
